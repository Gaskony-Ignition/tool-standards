{
  "custom": {},
  "params": {},
  "props": {},
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {},
    "children": [
      {
        "type": "ia.input.button",
        "meta": {
          "name": "Save"
        },
        "props": {
          "text": "Save"
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "type": "script",
              "scope": "G",
              "config": {
                "script": "\tsystem.perspective.print(quality)"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Status"
        },
        "props": {},
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "tag",
              "config": {
                "fallbackDelay": 2.5,
                "mode": "direct",
                "tagPath": "[System]Gateway/CurrentDateTime"
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\treturn \"%s at %s\" % (value, stamp)"
                }
              ]
            }
          }
        }
      }
    ]
  }
}
