{
  "custom": {},
  "params": {},
  "props": {},
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {},
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "NoRate"
        },
        "props": {},
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "runScript(\"pkg.mod.f\")"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Polled"
        },
        "props": {},
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "runScript(\"pkg.mod.f\", 1000, {view.params.path})"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Bound"
        },
        "props": {},
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "runScript(\"pkg.mod.f\", {view.custom.rate})"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Inline"
        },
        "props": {},
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "runScript(\"system.project.getProjectName()\", 0)"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Clock"
        },
        "props": {},
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "now()"
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\treturn pkg.mod.f(value)"
                }
              ]
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Ticking"
        },
        "props": {},
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "runScript(\"pkg.mod.f\", 0, now(5000))"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Raw"
        },
        "props": {},
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "tag(\"[default]Tank/Level\")"
              }
            }
          }
        }
      }
    ]
  }
}
